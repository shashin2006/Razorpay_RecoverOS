APP_NAME=RecoveryOS
APP_ENV=development
DEBUG=true

# Neon PostgreSQL
# Copy the connection string from Neon and use the SQLAlchemy psycopg scheme.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Stripe Test Mode
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# NVIDIA NIM
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=your_nvidia_model
NVIDIA_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety

# Local Stripe CLI development intentionally does not require
# STRIPE_WEBHOOK_SECRET. Production should verify Stripe signatures.

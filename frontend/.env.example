# VITE_API_BASE_URL: Base URL for FastAPI backend (default: http://127.0.0.1:8000)
VITE_API_BASE_URL="http://127.0.0.1:8000"

# VITE_USE_MOCK_DATA: Set to true only for isolated UI review when backend is offline (default: false)
VITE_USE_MOCK_DATA=false

# GEMINI_API_KEY: Optional server-side API key if needed
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL=""
